# Salin menjadi .env.local lalu isi nilainya. Jangan commit berkas .env.local.

# Lokasi data PGlite (Postgres lokal berbasis WASM).
PGLITE_DATA_DIR=.data/pglite

# Kata sandi untuk akun demo saat seeding. Ganti dengan nilai acak yang kuat.
SEED_PASSWORD=DemoIDB2026!

# Aktifkan mode demo client-side: route aplikasi diarahkan ke /demo dan
# reservasi disimpan di localStorage browser. Di Vercel, mode ini aktif
# otomatis lewat env VERCEL=1. Matikan untuk memakai database asli.
DEMO_MODE=true
