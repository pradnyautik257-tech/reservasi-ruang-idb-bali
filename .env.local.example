# Salin menjadi .env.local lalu isi nilainya. Jangan commit berkas .env.local.

# Lokasi data PGlite (Postgres lokal berbasis WASM).
PGLITE_DATA_DIR=.data/pglite

# Kata sandi untuk akun demo saat seeding. Ganti dengan nilai acak yang kuat.
SEED_PASSWORD=DemoIDB2026!

# Aktifkan tombol "masuk cepat" demo di halaman login. Matikan di produksi.
DEMO_MODE=true
